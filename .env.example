# ------------------------------------------------------------------
# 1. Токен бота от @BotFather
# ------------------------------------------------------------------
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Твой Telegram id (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# ------------------------------------------------------------------
# 2. ДВА КАНАЛА
# ------------------------------------------------------------------
# КАНАЛ 1 — НОВОСТНОЙ.
# Пользователь обязан подписаться на него, иначе бот не работает.
# Бот должен быть АДМИНОМ этого канала (иначе подписку не проверить).
# id вида -1001234567890
MAIN_CHANNEL_ID=-1001234567890
MAIN_CHANNEL_URL=https://t.me/your_channel

# КАНАЛ 2 — СЮДА ТЫ КИДАЕШЬ КРУЖКИ.
# Всё, что ты отправишь в этот канал, СРАЗУ появляется в ленте бота,
# без проверки. Бот должен быть АДМИНОМ этого канала.
SOURCE_CHANNEL_ID=

# Приватный канал-хранилище принятых кружков (необязательно).
# Бот должен быть админом. Оставь пустым, если не нужен.
STORAGE_CHANNEL_ID=

# ------------------------------------------------------------------
# 3. Каналы-спонсоры (реклама)
# Формат: id|ссылка|Название, элементы через запятую
# Бот должен быть АДМИНОМ в каждом канале, иначе проверка подписки не работает!
# ------------------------------------------------------------------
SPONSORS=-1001111111111|https://t.me/sponsor_one|Канал №1,-1002222222222|https://t.me/sponsor_two|Канал №2,-1003333333333|https://t.me/sponsor_three|Канал №3

# ------------------------------------------------------------------
# 4. Лимиты
# ------------------------------------------------------------------
FREE_VIEWS=5
BONUS_VIEWS=0

# ------------------------------------------------------------------
# 5. Оплата
# PAYMENT_MODE=stars    -> оплата звёздами Telegram (проще всего, без ИП)
# PAYMENT_MODE=provider -> оплата рублями через провайдера (нужен PROVIDER_TOKEN)
# ------------------------------------------------------------------
PAYMENT_MODE=stars
PAY_PACK_SIZE=5
PAY_PACK_STARS=20
PAY_PACK_RUB=50
PROVIDER_TOKEN=

# ------------------------------------------------------------------
# 6. Второй (пользовательский) аккаунт — для входа по MTProto.
# Нужен только если планируешь импорт кружков / постинг от лица аккаунта.
# api_id и api_hash берутся на https://my.telegram.org → API development tools.
# ВАЖНО: не присылай эти значения никому и не коммить .env.
# ------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=data/userbot.session

# ------------------------------------------------------------------
# 7. Прочее
# ------------------------------------------------------------------
DB_PATH=data/bot.db
# 1 — показывать пользователю его же кружки в ленте
FEED_INCLUDE_OWN=0
